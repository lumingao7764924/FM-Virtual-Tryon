# 复制到 apps/api/.env —— 不要提交真实密钥

PORT=8788
HOST=0.0.0.0
NODE_ENV=development
# 后台 web 与扫码 scan 的来源（逗号分隔）
CORS_ORIGIN=http://localhost:5180,https://localhost:5174
JWT_SECRET=dev-change-me-jwt-secret-use-long-random-string
COOKIE_SECURE=false

# Google 登录：GCP 控制台 → API 和服务 → 凭据 → OAuth 客户端 ID（Web）。不是密钥，可公开。
GOOGLE_CLIENT_ID=372608906672-jdqd67r8jpikq9grdr7229o3p5mc17pv.apps.googleusercontent.com
# 固定管理员（逗号分隔），永远能登录，防止把自己锁在外面
ADMIN_EMAILS=
# 开发期免 Google 登录（输入白名单邮箱即可登录；production 下强制关闭）
DEV_LOGIN=false

# 存储：local = 写 apps/api/.data/ 本地文件（干跑）；bigquery = 写 BQ（阶段六接入）
STORAGE=local
GCP_PROJECT_ID=feimei-virtual-tryon
BQ_DATASET=tryon
# GOOGLE_APPLICATION_CREDENTIALS=/绝对路径/keys/xxx.json

# 扫码页对外地址（生成二维码用）
PUBLIC_SCAN_BASE_URL=https://localhost:5174
